   "source": [
    "## 11. pascal tree\n",
    "def pascal(n):\n",
    "    for i in range(n):\n",
    "        num = 1\n",
    "        for j in range(i + 1):\n",
    "            print(num, end=\" \")\n",
    "            num = num * (i - j) // (j + 1)\n",
    "        print()\n",
    "n = int(input(\"Enter number: \"))\n",
    "pascal(n)"
   ]

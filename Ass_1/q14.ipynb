   ],
   "source": [
    "def triangle(n):\n",
    "    for i in range(1, n + 1):\n",
    "        print(\" \" * (n - i), end=\"\")\n",
    "        for j in range(i):\n",
    "            print(\"*\", end=\" \")\n",
    "        print()\n",
    "n = int(input(\"Enter number of rows: \"))\n",
    "triangle(n)"
   ]

   "source": [
    "def add1(n):\n",
    "    res = 0\n",
    "    place = 1\n",
    "    while n > 0:\n",
    "        digit = n % 10\n",
    "        digit = (digit + 1) % 10\n",
    "        res = res + digit * place\n",
    "        place = place * 10\n",
    "        n //= 10\n",
    "    print(res)\n",
    "n = int(input(\"Enter a number: \"))\n",
    "add1(n)"
   ]
